  "services": [
    {
      "id": "srv-1",
      "departmentId": "dept-1",
      "name": "Kebele Digital ID Registration & Issuance",
      "code": "KBL-DID",
      "description": "First-time biometric registration and digital smart ID card issuance for residents of the Woreda.",
      "durationMinutes": 30,
      "dailyQuota": 45,
      "feeETB": 0,
      "isActive": true,
      "requiredDocuments": [
        "Original Birth Certificate or Previous Kebele ID",
        "Two (2) recent passport-sized photographs (white background)",
        "Proof of residential address (House title or rental agreement)",
        "Completed Kebele resident registration form"
      ],
      "processingDays": "Same day (if documents are complete)"
    },
    {
      "id": "srv-2",
      "departmentId": "dept-1",
      "name": "Residence Certificate (Melkeya)",
      "code": "KBL-RES",
      "description": "Official certificate confirming verified residence within the Woreda for bank, passport, or court purposes.",
      "durationMinutes": 20,
      "dailyQuota": 60,
      "feeETB": 50,
      "isActive": true,
      "requiredDocuments": [
        "Valid Kebele Identification Card",
        "House rent agreement or ownership document",
        "Official request letter from institution (if applicable)"
      ],
      "processingDays": "Within 2 hours"
    },
    {
      "id": "srv-3",
      "departmentId": "dept-1",
      "name": "Vital Event: Birth Certificate Registration",
      "code": "KBL-BRT",
      "description": "Civil registration and official birth certificate issuance within the legal timeframe.",
      "durationMinutes": 30,
      "dailyQuota": 35,
      "feeETB": 100,
      "isActive": true,
      "requiredDocuments": [
        "Original hospital / clinic birth notification letter",
        "Valid Kebele IDs of both parents",
        "Parents' marriage certificate (if available)"
      ],
      "processingDays": "1 Business Day"
    },
    {
      "id": "srv-4",
      "departmentId": "dept-1",
      "name": "Vital Event: Marriage Certificate Issuance",
      "code": "KBL-MRG",
      "description": "Civil marriage registration and issuance of legally authenticated marriage certificates.",
      "durationMinutes": 45,
      "dailyQuota": 20,
      "feeETB": 150,
      "isActive": true,
      "requiredDocuments": [
        "Valid Kebele IDs of both spouses",
        "Certificate of single status / celibacy",
        "Two adult witnesses with valid identification",
        "Four passport photos each"
      ],
      "processingDays": "2 Business Days"
    },
    {
      "id": "srv-5",
      "departmentId": "dept-2",
      "name": "Landholding Rights Verification & Mapping",
      "code": "LND-VER",
      "description": "Verification of residential or commercial plot boundaries, cadastral records, and ownership verification.",
      "durationMinutes": 45,
      "dailyQuota": 25,
      "feeETB": 200,
      "isActive": true,
      "requiredDocuments": [
        "Original land title deed / certificate",
        "Cadastral site plan blueprint",
        "Current year land use tax receipt",
        "Valid National or Kebele ID"
      ],
      "processingDays": "3-5 Business Days"
    },
    {
      "id": "srv-6",
      "departmentId": "dept-2",
      "name": "Residential Building & Modification Permit",
      "code": "LND-PRM",
      "description": "Review and approval of residential renovation, fence construction, or structural expansion blueprints.",
      "durationMinutes": 40,
      "dailyQuota": 20,
      "feeETB": 350,
      "isActive": true,
      "requiredDocuments": [
        "Approved architectural drawings & engineering plan",
        "Land title certificate",
        "Adjacent property clearance consent"
      ],
      "processingDays": "5-7 Business Days"
    },
    {
      "id": "srv-7",
      "departmentId": "dept-3",
      "name": "Annual Trade License Renewal",
      "code": "TRD-RNW",
      "description": "Annual verification and renewal of commercial trade permits for retail, services, and local enterprises.",
      "durationMinutes": 25,
      "dailyQuota": 50,
      "feeETB": 300,
      "isActive": true,
      "requiredDocuments": [
        "Original previous year Trade License",
        "Current Tax Clearance Certificate from Woreda Revenue Office",
        "Premises lease agreement or property title",
        "Standard compliance inspection sign-off"
      ],
      "processingDays": "Same day"
    },
    {
      "id": "srv-8",
      "departmentId": "dept-3",
