      "durationMinutes": 45,
      "dailyQuota": 30,
      "feeETB": 500,
      "isActive": true,
      "requiredDocuments": [
        "Owner valid Kebele / National ID and TIN certificate",
        "Business premises rental contract authenticated by Document Auth Office",
        "Capital declaration statement",
        "3 passport photographs"
      ],
      "processingDays": "2 Business Days"
    },
    {
      "id": "srv-9",
