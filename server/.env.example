# Copy to .env and adjust. Every value has a development default (see config/index.js).
PORT=8080
JWT_SECRET=dev-secret-change-me
TZ=Africa/Addis_Ababa

# PostgreSQL (the database is created on first start when it does not exist)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=12345678
DB_NAME=woreda

# Per-IP request limits (5/s burst 50; sign-in/registration 20/min burst 10)
RATE_LIMIT_ENABLED=true

# Administrator created by `npm run seed`
SEED_ADMIN_NAME=Amir Siraj
SEED_ADMIN_EMAIL=amirsiraj1995@gmail.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_PHONE=+251938617803
