{
  "name": "@woreda/server",
  "version": "2.0.0",
  "private": true,
  "description": "WoredaCare backend: one Express application (layered: routes → middleware → controllers → services → repositories → PostgreSQL) with WebSocket live notices.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "migrate": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:fresh": "node scripts/migrate.js fresh",
    "migrate:fresh:seed": "node scripts/migrate.js fresh --seed",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language js",
    "seed": "node scripts/migrate.js seed",
    "seed:create": "node-pg-migrate create --migrations-dir seeds --migration-file-language js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@casl/ability": "^7.1.2",
    "bcryptjs": "2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.1.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.2",
    "node-pg-migrate": "9.0.0",
    "pg": "8.16.3",
    "pino": "9.6.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "nodemon": "3.1.14"
  }
}
