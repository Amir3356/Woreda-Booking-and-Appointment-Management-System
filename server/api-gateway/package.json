{
  "name": "@woreda/api-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Single entry point behind nginx: JWT check, identity headers, Redis response cache, reverse proxy to the services, WebSocket live notices fed by Kafka.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "5.1.0",
    "http-proxy-middleware": "3.0.7",
    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "kafkajs": "2.2.4",
    "pino": "9.6.0",
    "prom-client": "15.1.3",
    "ws": "8.22.0"
  }
}
