{
  "name": "@woreda/auth-service",
  "version": "1.0.0",
  "private": true,
  "description": "Citizen registration, sign-in (JWT + woreda_token cookie), profile lookup and logout with Redis token revocation and login lockout.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "express": "5.1.0",
    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.24.5",
    "pino": "9.6.0",
    "prom-client": "15.1.3"
  }
}
